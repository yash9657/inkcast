# Generated, vendored or machine-owned. `pnpm lint` and `pnpm format` run over
# the whole repo, so anything we do not hand-author has to be listed here or the
# check is noise and the write is destructive.

# Package manager and build output
pnpm-lock.yaml
dist/
.next/
out/
*.tsbuildinfo

# Written by tools that rewrite them on the next run
apps/web/next-env.d.ts

# Per-project working directories: storyboards, lessons, caches, frames, media.
# Anchored, for the reason spelled out at length in `.gitignore`: prettier reads these
# with gitignore semantics, so unanchored `projects/` also excused
# `apps/web/app/api/projects/**` from `prettier --check .` — the five owner-scoped route
# files were both untracked and unformatted, and the lint gate reported green over a hole.
/projects/
/renders/
/.inkcast/

# Screenshot gate output: ~70 PNGs plus a report per run of `scripts/screens.mjs`.
/.screens/

# Model weights fetched at runtime
.models/

# Binary-ish assets and vendored fonts
assets/fonts/*.ttf
assets/fonts/*.otf
assets/fonts/*.woff
assets/fonts/*.woff2
