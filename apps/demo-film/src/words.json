{
  "lines": [
    {
      "id": "vo0",
      "from": 0.0,
      "to": 5.445,
      "at": 0.8,
      "text": "Got something worth explaining? Type a topic, drop in a PDF, or paste a link.",
      "clipStart": 0.8
    },
    {
      "id": "vo1",
      "from": 6.246,
      "to": 14.071,
      "at": 7.0,
      "text": "Inkcast doesn't just summarize. It designs a lesson: a hook, a real example, and the mistake people usually make.",
      "clipStart": 6.96
    },
    {
      "id": "vo2",
      "from": 15.012,
      "to": 17.914,
      "at": 15.6,
      "text": "Then it draws it, every stroke in sync with the voice.",
      "clipStart": 15.56
    },
    {
      "id": "vo3",
      "from": 19.005,
      "to": 21.223,
      "at": 20.8,
      "text": "Choose the voice, the style, the shape.",
      "clipStart": 20.76
    },
    {
      "id": "vo4",
      "from": 21.548,
      "to": 25.344,
      "at": 23.6,
      "text": "Want a change? Just ask, and it redraws.",
      "clipStart": 23.56
    },
    {
      "id": "vo5",
      "from": 26.157,
      "to": 30.882,
      "at": 28.3,
      "text": "Download it, share a link, or host it yourself. It's open source.",
      "clipStart": 28.26
    },
    {
      "id": "vo6",
      "from": 31.324,
      "to": 35.341,
      "at": 33.8,
      "text": "Inkcast. Type a topic. Watch it get drawn.",
      "clipStart": 33.76
    }
  ],
