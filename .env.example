# Preferred cloud planner, drawings and visual review; speech stays local with Kokoro.
FIREWORKS_API_KEY=
# INKCAST_PLANNER=fireworks
# INKCAST_FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
# Optional: named effort, or a supported numeric reasoning-token budget.
# INKCAST_FIREWORKS_REASONING=4096

# Inkcast configuration — copy to `.env` and edit. Every line is optional.
#
# Inkcast runs end to end with this file completely empty: the planner, the
# voice and the artwork all have local defaults, and the renderer is Playwright
# plus ffmpeg on your own machine. Keys below are per-stage *upgrades*. A missing
# key selects the local default. A failed configured cloud lesson stops a strict
# run before narration; --degrade permits explicitly diagnostic fallback output.
#
# `inkcast providers` prints exactly which provider each stage will use and why.

# ─────────────────────────────────────────────────────────── planning (opt-in)

# Claude writes tighter scripts than the built-in planner, which matters most on
# long or badly structured documents. Also enables free-form `inkcast edit`
# instructions instead of the local pattern-matched ones.
# WITHOUT IT: the deterministic heuristic planner runs — structure-aware, offline,
# free, and slightly more literal. Editing still works, via matched patterns.
# ANTHROPIC_API_KEY=sk-ant-...

# Which planner to use. `local` (or `heuristic`) forces the offline planner even
# when a key is present; `anthropic` uses the default model; any Claude model id
# selects that model (`claude-sonnet-5` is the sensible cost tier).
# WITHOUT IT: Fireworks when its key is set, otherwise Anthropic, otherwise local.
# Default model: claude-opus-5
# INKCAST_PLANNER=claude-sonnet-5

# ────────────────────────────────────────────────────────────── voice (opt-in)

# ElevenLabs narration: more natural prosody, more languages, voice cloning.
# WITHOUT IT: Kokoro-82M runs locally through kokoro-js — free and offline after
# a one-time ~92 MB model download. On macOS, `say` is the last-resort fallback.
# ELEVENLABS_API_KEY=...

# Default voice id, overriding `storyboard.meta.voice` (and so `--voice`'s
# default). Kokoro ids are local: af_heart, af_bella, am_puck, bf_emma, bm_george…
# A non-Kokoro id routes to ElevenLabs, which requires ELEVENLABS_API_KEY.
# WITHOUT IT: af_heart, local.
# INKCAST_VOICE=af_heart

# ──────────────────────────────────────────────────────────── artwork (opt-in)

# Replicate — text-to-image for richer illustrations, vectorised before drawing.
# WITHOUT IT: the built-in library (2000+ stroke icons) plus procedural diagrams.
# That path is free, offline, and deterministic; it just cannot draw a bespoke
# character.
# REPLICATE_API_TOKEN=r8_...

# fal.ai — same job as Replicate, different host. Replicate wins if both are set.
# WITHOUT IT: as above.
# FAL_KEY=...

# ─────────────────────────────────────────────────────────────────── plumbing

# Log verbosity: debug | info | warn | error.
# WITHOUT IT: `info` for library/web use; the CLI quiets this to `warn` so log
# lines do not fight the progress bar, and `--verbose` restores `debug`.
# INKCAST_LOG=info

# Where project directories are written. Relative paths resolve against the
# current working directory, so prefer an absolute path if you set it at all.
# WITHOUT IT: `projects/` at the repo root (the CLI pins it there even when it is
# invoked from a subdirectory).
# INKCAST_PROJECTS=/absolute/path/to/projects

# How many frames the renderer captures in parallel. More workers finish sooner
# and use more RAM — each worker is a Chromium page.
# WITHOUT IT: the render stage picks a default from the core count.
# INKCAST_RENDER_WORKERS=4

# ───────────────────────────────────────── stateless hosting (Vercel) only

# Stores project records, progress and finished films in Vercel Blob instead of
# INKCAST_PROJECTS, and hands rendering to the render service. Leave unset for the
# CLI, `pnpm dev` and Docker. Full setup: docs/DEPLOY_VERCEL.md.
# INKCAST_STORAGE=blob

# Read by @vercel/blob; set automatically when a Blob store is connected.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Top-level folder in the Blob store (keeps previews apart from production) and
# the store's access mode. Defaults: inkcast, private.
# INKCAST_BLOB_PREFIX=inkcast
# INKCAST_BLOB_ACCESS=private

# Where the studio sends renders, and the shared secret both sides check.
#   openssl rand -hex 32
# INKCAST_RENDER_URL=https://inkcast-render.vercel.app
# INKCAST_RENDER_TOKEN=
# Only if the render project sits behind Vercel Deployment Protection.
# INKCAST_RENDER_BYPASS_TOKEN=

# ───────────────────────────────────────────── read by tools we depend on, FYI

# NO_COLOR=1                      # any value disables CLI colour
# PLAYWRIGHT_BROWSERS_PATH=...    # where Playwright looks for its Chromium build
