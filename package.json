{
  "name": "inkcast",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI explainer videos. Documents in, hand-drawn whiteboard video out.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @inkcast/web dev",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "cast": "pnpm --filter @inkcast/cli exec tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
