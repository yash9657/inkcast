# Native and self-locating packages, hoisted into the root `node_modules`.
#
# The studio runs the pipeline in-process, so `apps/web`'s Next build has to mark
# these as server externals — bundling a `.node` binary is not a thing webpack can
# do. But Next decides whether a package *can* be externalised by resolving it
# from the app directory (`handle-externals.js` calls `resolveExternal(dir, …)`
# with `dir` = `apps/web`), and pnpm's default isolated layout only links
# `onnxruntime-node` under `packages/voice/node_modules`. Unresolvable from the
# app root means "bundle it", which then fails on the first binary file.
#
# Hoisting is the fix that keeps one version range per package: the alternative
# is re-declaring all of these in `apps/web/package.json`, where they would drift
# from the stage packages that actually own them.
#
# Everything listed here is a real runtime requirement, not a convenience:
#   playwright*    — launches Chromium, resolves its own driver + browser revisions
#   onnxruntime*   — loads `.node` addons for local Kokoro TTS
#   @huggingface/* — the ONNX runtime host; pulls sharp
#   kokoro-js      — the zero-key default voice
#   sharp          — native image addon
#   lucide-static  — located via `createRequire().resolve()`, read as files on disk
#   @neplex/*      — optional native vectoriser for the opt-in image lane
public-hoist-pattern[]=playwright
public-hoist-pattern[]=playwright-core
public-hoist-pattern[]=onnxruntime-node
public-hoist-pattern[]=onnxruntime-common
public-hoist-pattern[]=onnxruntime-web
public-hoist-pattern[]=@huggingface/*
public-hoist-pattern[]=kokoro-js
public-hoist-pattern[]=sharp
public-hoist-pattern[]=lucide-static
public-hoist-pattern[]=@neplex/*
